[Unit]
Description=Cloudflare Quick Tunnel for motapath-observer-mcp
After=network.target motapath-observer.service
Wants=motapath-observer.service

[Service]
Type=simple
WorkingDirectory=%h/motapath-solver/observer-mcp
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8788 --logfile %h/motapath-solver/observer-mcp/tunnel.log
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
